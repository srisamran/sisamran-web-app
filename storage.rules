rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // อนุญาตให้ผู้ที่ login แล้วอ่าน-เขียน temp_preview ได้
    match /temp_preview/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // อื่นๆ ต้อง login
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
